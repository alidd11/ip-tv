{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/channel.schema.json",
  "title": "IP TV Channel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "shortName",
    "aliases",
    "country",
    "languages",
    "categories",
    "network",
    "website",
    "logo",
    "epgIds",
    "enabled",
    "isAdult",
    "sortOrder",
    "tags",
    "access"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shortName": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{3}$"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "network": {
      "type": [
        "string",
        "null"
      ]
    },
    "website": {
      "type": [
        "string",
        "null"
      ]
    },
    "logo": {
      "type": [
        "string",
        "null"
      ]
    },
    "epgIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "isAdult": {
      "type": "boolean"
    },
    "sortOrder": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "providerIds",
        "packageIds"
      ],
      "properties": {
        "model": {
          "enum": [
            "free-to-air",
            "free-stream",
            "subscription",
            "ppv",
            "mixed"
          ]
        },
        "providerIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packageIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
