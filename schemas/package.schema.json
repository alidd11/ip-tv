{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/package.schema.json",
  "title": "IP TV Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "providerId",
    "name",
    "country",
    "accessModel",
    "website",
    "channelIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "accessModel": {
      "enum": [
        "free",
        "subscription",
        "ppv",
        "mixed"
      ]
    },
    "website": {
      "type": "string",
      "minLength": 1
    },
    "channelIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
