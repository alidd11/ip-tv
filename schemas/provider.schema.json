{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/provider.schema.json",
  "title": "IP TV Provider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "country",
    "website",
    "accessModel",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "website": {
      "type": "string",
      "minLength": 1
    },
    "accessModel": {
      "enum": [
        "free",
        "subscription",
        "mixed"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
