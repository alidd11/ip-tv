{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/country.schema.json",
  "title": "IP TV Country",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "flag",
    "enabled",
    "featured",
    "sortOrder"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "flag": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "featured": {
      "type": "boolean"
    },
    "sortOrder": {
      "type": "integer",
      "minimum": 0
    }
  }
}
